# Microsoft Defender XDR MCP server. Copy to `.env` and fill in real values.
# See README.md for setup details (cert generation, App Registration, permissions).
# NEVER commit `.env`.

# --- Single-tenant mode ---

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CERT_PATH=/absolute/path/to/app-cert.pfx
# AZURE_CERT_PASSPHRASE=

# --- Multi-tenant mode (overrides the single-tenant vars above) ---
# See tenants.example.json for the file schema. File must be 0600 on POSIX.
# MCP_DEFENDER_XDR_TENANTS_FILE=/etc/mcp-defender-xdr/tenants.json
#
# Per-tenant quotas (`default_quota` / `quota`) are set in the tenants file,
# not here. See README "Per-tenant quotas".

# --- Credential providers: Azure Key Vault / AWS Secrets Manager ---
# Configured per tenant in the tenants file ("provider": "keyvault" or
# "aws-secretsmanager"); see tenants.cloud.example.json. They are not
# available through the single-tenant AZURE_* variables above.
# Install the extra:  uv pip install -e ".[keyvault]"  or  ".[aws-secretsmanager]"
#
# Key Vault signs in with DefaultAzureCredential. On a host with a managed or
# workload identity nothing is needed here. For an environment service
# principal (CI, a laptop without `az login`):
# AZURE_CLIENT_SECRET=...            # together with AZURE_TENANT_ID / AZURE_CLIENT_ID
#                                    # of the *Key Vault reader* principal. Do not
#                                    # reuse the Defender app's AZURE_CLIENT_ID here;
#                                    # prefer `keyvault_identity_client_id` in the file.
#
# AWS Secrets Manager uses the standard AWS credential chain (IRSA, ECS task
# role, instance profile, or a profile). For a named profile:
# AWS_PROFILE=secops

# --- Transport ---
# stdio (default): the MCP client launches the server. Nothing to set.
# http: a long-running service at http://127.0.0.1:8765/mcp. Requires the JWT
# settings below; see README "HTTP transport" and THREAT_MODEL.md T8.
# MCP_DEFENDER_XDR_TRANSPORT=http
# MCP_DEFENDER_XDR_HTTP_HOST=127.0.0.1
# MCP_DEFENDER_XDR_HTTP_PORT=8765
# MCP_DEFENDER_XDR_HTTP_PATH=/mcp
#
# Required for a non-loopback bind (or set the exact proxy opt-in below):
# MCP_DEFENDER_XDR_HTTP_TLS_CERTFILE=/etc/mcp-defender-xdr/tls/cert.pem
# MCP_DEFENDER_XDR_HTTP_TLS_KEYFILE=/etc/mcp-defender-xdr/tls/key.pem
# MCP_DEFENDER_XDR_HTTP_ALLOW_PLAINTEXT=behind-tls-terminating-proxy
#
# DNS-rebinding protection: Host / Origin allowlists (comma-separated).
# MCP_DEFENDER_XDR_HTTP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:443
# MCP_DEFENDER_XDR_HTTP_ALLOWED_ORIGINS=

# --- HTTP bearer tokens (required when MCP_DEFENDER_XDR_TRANSPORT=http) ---
# MCP_DEFENDER_XDR_JWT_AUDIENCE=mcp-defender-xdr://soc-prod
# MCP_DEFENDER_XDR_JWT_ISSUER=https://tokens.example.com
# MCP_DEFENDER_XDR_JWT_ALGORITHM=HS256
# Either a >=32-byte shared secret (HS256/384/512) ...
# MCP_DEFENDER_XDR_JWT_SECRET=
# ... or a PEM public key (RS*, PS*, ES*, EdDSA). Never both.
# MCP_DEFENDER_XDR_JWT_PUBLIC_KEY_FILE=/etc/mcp-defender-xdr/jwt-signer.pub.pem
# MCP_DEFENDER_XDR_JWT_MAX_TTL_SECONDS=900
# MCP_DEFENDER_XDR_JWT_LEEWAY_SECONDS=30

# --- Offline fixture mode (no Azure tenant / cert required) ---
# Serves recorded synthetic responses instead of calling Azure, and skips
# credential validation entirely, so the server boots with nothing else set.
# Must match this value EXACTLY; any other non-empty value fails startup with
# exit code 2 rather than resolving to either mode. See examples/README.md.
# MCP_DEFENDER_XDR_FIXTURE_MODE=synthetic-fixtures-no-live-data

# --- Optional tuning ---
# DEFENDER_API_BASE=https://api.securitycenter.microsoft.com
# MCP_DEFENDER_XDR_LOG_LEVEL=INFO
