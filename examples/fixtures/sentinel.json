      {
        "id": "/subscriptions/00000000-0000-0000-0000-00000000f1c5/resourceGroups/rg-fixture-soc/providers/Microsoft.OperationalInsights/workspaces/law-fixture-sentinel/savedSearches/fixture-hunt-beaconing",
        "name": "fixture-hunt-beaconing",
        "type": "Microsoft.OperationalInsights/savedSearches",
        "properties": {
          "category": "Hunting Queries",
          "displayName": "Periodic outbound beaconing to a single external IP",
          "query": "CommonSecurityLog\n| where DeviceAction == \"allow\"\n| summarize Connections = count(), Bytes = sum(ReceivedBytes) by SourceHostName, DestinationIP, bin(TimeGenerated, 10m)\n| where Connections > 3",
          "tags": [
            {
              "name": "tactics",
              "value": "CommandAndControl"
            },
            {
              "name": "techniques",
              "value": "T1071,T1571"
            },
            {
              "name": "description",
              "value": "Finds hosts making repeated connections to the same external IP on a fixed cadence. Synthetic fixture query."
            }
          ],
          "version": 2
        }
      },
      {
        "id": "/subscriptions/00000000-0000-0000-0000-00000000f1c5/resourceGroups/rg-fixture-soc/providers/Microsoft.OperationalInsights/workspaces/law-fixture-sentinel/savedSearches/fixture-hunt-runkey",
        "name": "fixture-hunt-runkey",
        "type": "Microsoft.OperationalInsights/savedSearches",
        "properties": {
          "category": "Hunting Queries",
          "displayName": "New Run-key persistence written by rundll32",
          "query": "DeviceRegistryEvents\n| where RegistryKey has @\"\\CurrentVersion\\Run\"\n| where InitiatingProcessFileName =~ \"rundll32.exe\"",
          "tags": [
            {
              "name": "tactics",
              "value": "Persistence"
            },
            {
              "name": "techniques",
              "value": "T1547.001"
            },
            {
              "name": "description",
              "value": "Registry Run keys set by rundll32 are a common post-exploitation persistence step. Synthetic fixture query."
            }
          ],
          "version": 2
        }
      },
      {
        "id": "/subscriptions/00000000-0000-0000-0000-00000000f1c5/resourceGroups/rg-fixture-soc/providers/Microsoft.OperationalInsights/workspaces/law-fixture-sentinel/savedSearches/fixture-hunt-lsass",
        "name": "fixture-hunt-lsass",
        "type": "Microsoft.OperationalInsights/savedSearches",
        "properties": {
          "category": "Hunting Queries",
          "displayName": "Non-standard process opening LSASS",
          "query": "DeviceEvents\n| where ActionType == \"OpenProcessApiCall\" and FileName =~ \"lsass.exe\"\n| where InitiatingProcessFileName !in~ (\"MsMpEng.exe\", \"svchost.exe\")",
          "tags": [
            {
              "name": "tactics",
              "value": "CredentialAccess"
            },
            {
              "name": "techniques",
              "value": "T1003.001"
            },
            {
              "name": "description",
              "value": "Processes other than known security tooling reading LSASS memory. Synthetic fixture query."
            }
          ],
          "version": 2
        }
